<?php
/**
 * @file
 * Drop Pay — payment gateway abstraction for Drop Suite.
 *
 * This module provides a generic drop_payment entity, a gateway plugin
 * interface (hook_drop_pay_gateways), and a dispatch API (drop_pay_charge).
 * Gateway-specific implementations live in submodules — drop_pay_stripe,
 * drop_pay_paypal, etc. Offline payments (cash, check) are recorded with
 * drop_pay_record_payment() under the reserved gateway name 'manual'.
 */

/**
 * Gateway name stored on payments recorded offline (cash, check, etc.).
 */
define('DROP_PAY_MANUAL', 'manual');

// ---------------------------------------------------------------------------
// Autoload
// ---------------------------------------------------------------------------

/**
 * Implements hook_autoload_info().
 */
function drop_pay_autoload_info() {
  return array(
    'DropPayment'           => 'drop_pay.entity.inc',
    'DropPaymentController' => 'drop_pay.entity.inc',
  );
}

// ---------------------------------------------------------------------------
// Entity info
// ---------------------------------------------------------------------------

/**
 * Implements hook_entity_info().
 */
function drop_pay_entity_info() {
  return array(
    'drop_payment' => array(
      'label'                  => t('Payment'),
      'plural label'           => t('Payments'),
      'description'            => t('A payment processed via a drop_pay gateway.'),
      'entity class'           => 'DropPayment',
      'controller class'       => 'DropPaymentController',
      'views controller class' => 'EntityPlusDefaultViewsController',
      'base table'             => 'drop_payment',
      'fieldable'              => FALSE,
      'entity keys'            => array(
        'id' => 'pid',
      ),
      'uri callback'           => 'entity_class_uri',
      'access callback'        => 'drop_pay_payment_access',
      'module'                 => 'drop_pay',
    ),
  );
}

